{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pingr AI",
  "appearance": {
    "default": "dark"
  },
  "colors": {
    "primary": "#10B981",
    "light": "#059669",
    "dark": "#10B981"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Voice Agents & Telephony",
            "pages": [
              "agents/overview",
              "agents/create",
              "telephony/outbound-calls"
            ]
          },
          {
            "group": "Automations & Campaigns",
            "pages": [
              "campaigns/scheduling",
              "webhooks/overview"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "icon": "circle-info",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/pagination",
              "api-reference/rate-limiting",
              "api-reference/errors",
              "api-reference/limits"
            ]
          },
          {
            "group": "Agents",
            "icon": "robot",
            "pages": [
              "api-reference/agents/overview",
              "api-reference/agents/get-agent",
              "api-reference/agents/create-agent",
              "api-reference/agents/list-agents",
              "api-reference/agents/update-agent",
              "api-reference/agents/delete-agent"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "baseUrl": "https://api.pingr.ai",
    "auth": {
      "method": "bearer"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#09090B"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "App Dashboard",
        "href": "http://localhost:3000/dashboard"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch Console",
      "href": "http://localhost:3000"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com"
    }
  }
}