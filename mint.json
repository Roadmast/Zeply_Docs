{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Pingr AI",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#10B981",
    "light": "#059669",
    "dark": "#10B981",
    "background": {
      "dark": "#09090B",
      "light": "#FFFFFF"
    }
  },
  "modeToggle": {
    "default": "dark"
  },
  "codeBlock": {
    "mode": "dark"
  },
  "topbarLinks": [
    {
      "name": "App Dashboard",
      "url": "http://localhost:3000/dashboard"
    }
  ],
  "topbarCtaButton": {
    "name": "Launch Console",
    "url": "http://localhost:3000"
  },
  "tabs": [
    {
      "name": "Guides",
      "url": "introduction"
    },
    {
      "name": "API Reference",
      "url": "api-reference/introduction"
    }
  ],
  "navigation": [
    {
      "group": "Getting Started",
      "pages": [
        "introduction",
        "quickstart",
        "authentication"
      ]
    },
    {
      "group": "Voice Agents & Telephony",
      "pages": [
        "agents/overview",
        "agents/create",
        "telephony/outbound-calls"
      ]
    },
    {
      "group": "Automations & Campaigns",
      "pages": [
        "campaigns/scheduling",
        "webhooks/overview"
      ]
    },
    {
      "group": "Overview",
      "icon": "circle-info",
      "pages": [
        "api-reference/introduction",
        "api-reference/authentication",
        "api-reference/pagination",
        "api-reference/rate-limiting",
        "api-reference/errors",
        "api-reference/limits"
      ]
    },
    {
      "group": "Agents",
      "icon": "robot",
      "pages": [
        "api-reference/agents/overview",
        "api-reference/agents/get-agent",
        "api-reference/agents/create-agent",
        "api-reference/agents/list-agents",
        "api-reference/agents/update-agent",
        "api-reference/agents/delete-agent"
      ]
    }
  ],
  "api": {
    "baseUrl": "https://api.pingr.ai",
    "auth": {
      "method": "bearer"
    }
  },
  "footerSocials": {
    "github": "https://github.com"
  }
}
